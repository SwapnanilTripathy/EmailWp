PORT=3000
BASE_URL=http://localhost:3000

# Gmail OAuth 2.0 credentials from Google Cloud
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/auth/google/callback
GMAIL_REFRESH_TOKEN=

# Gmail account to monitor
GMAIL_USER=me

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=919XXXXXXXXX

# How often to check Gmail, in milliseconds
POLL_INTERVAL_MS=30000

# Optional: only forward emails matching these comma-separated sender/subject terms
# Leave blank to forward every new email.
FILTER_TERMS=
